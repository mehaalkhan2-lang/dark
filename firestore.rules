rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidSignal(data, isCreate) {
      return data.keys().hasAll(['pair', 'expiry', 'durationMinutes', 'type', 'status', 'createdAt', 'authorId']) &&
             data.keys().size() >= 7 && data.keys().size() <= 9 &&
             data.pair is string && data.pair.size() <= 20 &&
             (!('direction' in data) || (data.direction in ['CALL', 'PUT'])) &&
             (!('entryPrice' in data) || (data.entryPrice is string && data.entryPrice.size() <= 20)) &&
             data.expiry is timestamp &&
             data.durationMinutes is int &&
             data.type in ['public', 'vip'] &&
             data.status in ['pending', 'active', 'win', 'loss', 'expired'] &&
             (isCreate ? data.createdAt == request.time : data.createdAt == resource.data.createdAt) &&
             (isCreate ? data.authorId == request.auth.uid : data.authorId == resource.data.authorId);
    }

    function isValidReview(data) {
      return data.keys().hasAll(['username', 'imageUrl', 'createdAt']) &&
             data.username is string && data.username.size() <= 50 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             (!('comment' in data) || (data.comment is string && data.comment.size() <= 500)) &&
             (!('profitAmount' in data) || (data.profitAmount is string && data.profitAmount.size() <= 50)) &&
             data.createdAt is timestamp;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['isActive']) &&
             data.isActive is bool &&
             (!('startedAt' in data) || (data.startedAt is timestamp || data.startedAt == null)) &&
             (!('closedAt' in data) || (data.closedAt is timestamp || data.closedAt == null)) &&
             (!('lastStatus' in data) || (data.lastStatus is string && data.lastStatus.size() <= 20));
    }

    function isValidPushToken(data) {
      return data.keys().hasAll(['token', 'updatedAt', 'active']) &&
             data.keys().size() >= 3 && data.keys().size() <= 4 &&
             data.token is string && data.token.size() <= 512 &&
             data.updatedAt == request.time &&
             data.active is bool &&
             (!('platform' in data) || (data.platform is string && data.platform.size() <= 100));
    }

    // --- Collection Rules ---

    match /system/trading_session {
      allow read: if true;
      allow write: if isAdmin() && isValidSession(incoming());
    }

    match /push_tokens/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidPushToken(incoming());
    }

    match /signals/{signalId} {
      // Public signals can be listed by anyone.
      // VIP signals can only be listed by admins or authenticated users (who will then be filtered in 'get')
      allow list: if resource.data.type == 'public' || isSignedIn(); 
      allow get: if resource.data.type == 'public' || 
                 (isSignedIn() && (
                   isAdmin() || 
                   exists(/databases/$(database)/documents/vips/$(request.auth.uid))
                 ));
      
      allow create: if isAdmin() && 
                    isValidId(signalId) && 
                    isValidSignal(incoming(), true);
      
      allow update: if isAdmin() && 
                    isValidSignal(incoming(), false) && (
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'direction', 'pair', 'entryPrice', 'expiry'])
                    );
                    
      allow delete: if isAdmin();
    }

    match /vips/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      // Allow bootstrapping and idempotency
      allow create, update: if isSignedIn() && 
                    request.auth.token.email == "mehaalkhan.2@gmail.com" && 
                    request.auth.token.email_verified == true &&
                    adminId == request.auth.uid;
      allow delete: if false; 
    }

    match /bot_access/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /bot_activations/{activationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'verifying';
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin() && isValidReview(incoming());
    }
  }
}
